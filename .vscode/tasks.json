{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "kittyscript: install extension",
      "type": "process",
      "command": "${workspaceFolder}/kittycli",
      "windows": {
        "command": "${workspaceFolder}\\kittycli.exe"
      },
      "args": ["vscode"],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
